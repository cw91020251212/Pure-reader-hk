{
  "name": "PureRead HK｜純淨閱讀器",
  "short_name": "PureRead HK",
  "description": "純淨閱讀、文章整理與文字朗讀工具。",
  "lang": "zh-HK",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "./icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "text/markdown",
            ".md",
            "text/plain",
            ".txt"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
