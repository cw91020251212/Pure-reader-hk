{
  "name": "PureRead HK｜純淨閱讀器",
  "short_name": "PureRead HK",
  "description": "純淨閱讀、文章整理與文字朗讀工具。",
  "version": "1.58",
  "lang": "zh-HK",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon.jpeg",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/plain": [
          ".txt"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/msword": [
          ".doc"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/vnd.ms-word.document.macroEnabled.12": [
          ".docm"
        ],
        "application/rtf": [
          ".rtf"
        ],
        "application/vnd.oasis.opendocument.text": [
          ".odt"
        ],
        "application/epub+zip": [
          ".epub"
        ],
        "text/csv": [
          ".csv"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "text/markdown",
            ".md",
            ".markdown",
            "text/plain",
            ".txt",
            "application/pdf",
            ".pdf",
            "application/msword",
            ".doc",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/vnd.ms-word.document.macroEnabled.12",
            ".docm",
            "application/rtf",
            ".rtf",
            "application/vnd.oasis.opendocument.text",
            ".odt",
            "application/epub+zip",
            ".epub",
            "text/csv",
            ".csv"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
